{
  "name": "eneros-billing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EnerOS \u2014 the AI energy manager for UK SMEs. Energy billing, bill auditing and optimisation console.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "dev:all": "concurrently -k -n web,api,py -c blue,green,magenta \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:backend\"",
    "dev:web": "next dev -p 3000",
    "dev:api": "npm --prefix server run dev:memory",
    "dev:api:mongo": "npm --prefix server run dev",
    "dev:backend": "node scripts/dev-backend.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "verify:connector": "tsx scripts/verify-connector.ts",
    "verify:theme": "tsx scripts/theme-check.tsx",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^1.51.0",
    "next": "^16.4.3",
    "postcss": "^8.5.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "dotenv": "^16.4.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
