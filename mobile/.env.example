# Mobile app (Expo). Copy to `.env`.
# EXPO_PUBLIC_* variables are embedded into the client bundle at build time.

# Base URL of the EnerOS API.
#  • iOS simulator / Expo web: http://localhost:4000
#  • Android emulator:        http://10.0.2.2:4000
#  • Physical device:         http://<your-lan-ip>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Clerk keys come from the API's /api/config endpoint, so they only need to be
# set in server/.env — no need to duplicate them here.
