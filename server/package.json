{
  "name": "eneros-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EnerOS API — MongoDB + Clerk + Cloudflare R2 backend shared by the web and mobile apps.",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "dev:memory": "tsx src/local-memory.ts",
    "start": "tsx src/local.ts",
    "seed": "tsx src/seed/seed.ts",
    "seed:user": "tsx src/scripts/seed-user.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "verify:analysis": "tsx src/scripts/verify-analysis.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "verify:live": "tsx src/scripts/verify-live.ts",
    "verify:copilot": "tsx src/scripts/verify-copilot.ts",
    "verify:gemini": "tsx src/scripts/verify-gemini.ts",
    "verify:safety": "tsx src/scripts/verify-safety.ts",
    "verify:billing": "tsx src/scripts/verify-billing.ts",
    "verify:ingest": "tsx src/scripts/verify-ingest.ts",
    "verify:intake": "tsx src/scripts/verify-intake.ts",
    "verify:pdfjs": "tsx src/scripts/verify-pdfjs.ts",
    "verify:subscription": "tsx src/scripts/verify-subscription.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@clerk/backend": "^1.21.4",
    "@clerk/express": "^1.3.31",
    "@types/http-proxy-middleware": "^0.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-proxy-middleware": "^4.2.1",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.6",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
