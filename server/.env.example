# ─────────────────────────────────────────────────────────────────────────────
# EnerOS API — environment configuration
# Copy to `server/.env` and fill in. The server boots without every value set:
#   • no MONGODB_URI → falls back to a local mongod at mongodb://127.0.0.1:27017
#   • no CLERK keys  → falls back to built-in dev auth (demo email + password)
#   • no R2 keys     → uploads are rejected, the rest of the API still works
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000

# MongoDB — local or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/eneros
# Optional: override the database name
# MONGODB_DB=eneros

# Clerk (free tier) — create an application at https://dashboard.clerk.com
# Leave blank to use the built-in dev auth mode with the demo credentials below.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloudflare R2 — create a bucket + API token at https://dash.cloudflare.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eneros-invoices
# Optional public/custom domain for the bucket (enables permanent URLs)
# R2_PUBLIC_BASE_URL=https://files.example.com

# Comma-separated origins allowed to call the API (web dev server, Expo web, native)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# The demo account — used by `npm run seed` and the dev auth mode.
# IMPORTANT: use these exact credentials on web and mobile so both share data.
DEMO_EMAIL=demo@eneros.app
DEMO_PASSWORD=EnerOS-demo-2026
DEMO_NAME=Demo Operator
DEMO_ORG=Harbour Hospitality Group

# Secret used to sign dev-mode tokens (only relevant when Clerk is not configured)
DEV_AUTH_SECRET=change-me-in-production

# Provision the seeded demo dataset for any new (non-demo) user on first load
AUTO_PROVISION=true
