# ─────────────────────────────────────────────────────────────────────────────
# EnerOS API — environment configuration
# Copy to `server/.env` and fill in. The server boots without every value set:
#   • no MONGODB_URI → falls back to a local mongod at mongodb://127.0.0.1:27017
#   • no Clerk keys  → falls back to built-in dev auth (demo email + password)
#   • no R2 keys     → uploads are rejected, the rest of the API still works
#   • no ANTHROPIC_* → the Smart Analysis engine still runs, extraction is disabled
#
# On Vercel set these as Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000

# MongoDB — local or Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/eneros
# Optional: override the database name in the connection string
# MONGODB_DB=eneros

# ── Clerk (free tier) — https://dashboard.clerk.com ────────────────────────────
# BOTH keys are required for Clerk to be enabled. The publishable key is served
# to the browser through /api/config, so it only ever needs to live here.
# Leave both blank to use the built-in dev auth mode with the demo credentials.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Cloudflare R2 — create a bucket + API token at https://dash.cloudflare.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public/custom domain for the bucket (enables permanent URLs)
# R2_PUBLIC_BASE_URL=https://files.example.com

# Comma-separated origins allowed to call the API (web dev server, Expo web, native)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# ── Demo account — used by `npm run seed` and by the dev auth mode ─────────────
# IMPORTANT: use these exact credentials on web and mobile so both share data.
DEMO_EMAIL=demo@eneros.app
DEMO_PASSWORD=EnerOS-demo-2026
DEMO_NAME=Demo Operator
DEMO_ORG=Harbour Hospitality Group

# Secret used to sign dev-mode tokens (only relevant when Clerk is not configured)
DEV_AUTH_SECRET=change-me-in-production

# Provision the seeded demo dataset for any new (non-demo) user on first load
AUTO_PROVISION=true

# ── Smart Analysis (optional enrichment) ───────────────────────────────────────
# The deterministic engine in server/src/lib/analysis.ts needs NONE of these.
# They only enable bill text extraction and weather normalisation.

# Anthropic — turns pasted bill text (or PDF text) into typed fields.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Gemini API key — enables grounded chat for the Copilot.
GEMINI_API_KEY=
# Optional: pin a specific model. Left UNSET (recommended), the server asks the
# API which models the key can use (ListModels) and always picks the cheapest
# one available (flash-lite → flash → pro), so retired names such as
# gemini-1.5-flash can never break the Copilot again.
# GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_MODEL=claude-sonnet-4-5

# Elexon Insights API — public and key-less. Half-hourly temperature data, used
# so consumption can be normalised for weather before flagging anomalies.
ELEXON_BASE_URL=https://api.elexon.co.uk/insights/api
UPSTREAM_TIMEOUT_MS=6000
# ── Live UK energy data (real-time, public, key-less) ──────────────────────────
# The live layer pulls actual GB market data. It needs NO keys and degrades
# gracefully: with no network the app still runs on the deterministic engine.
#
# Octopus Energy public tariff API — real half-hourly Agile Octopus prices for
# the customer's distribution region (A–P, matching Ofgem's 14 cap regions).
OCTOPUS_BASE_URL=https://api.octopus.energy/v1
AGILE_PRODUCT=AGILE-24-10-01
# Default region letter used when a site has no postcode (C = London).
AGILE_REGION=C

# NESO Carbon Intensity API — current + forecast gCO2/kWh for GB.
CARBON_BASE_URL=https://api.carbonintensity.org.uk

# Per-request upstream timeout, and how long a fetched price curve is reused.
LIVE_TIMEOUT_MS=7000
LIVE_CACHE_TTL_MS=900000
