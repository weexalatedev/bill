# Python connector service — local configuration.
#
# LOCAL DEV: you normally do NOT need this file. `npm run setup` creates a single
# `.env` at the repo root (see ../.env.example) and `npm run dev:all` passes it to
# uvicorn, so APP_API_TOKEN matches server/.env automatically. This file is read
# as a fallback when it exists (backend/app/config.py loads it via python-dotenv
# for a manual `uvicorn app.main:app`), and the root `.env` wins on conflicts.
#
# Generate the encryption key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Bearer token your own frontend must send to this backend (replace with real user auth later)
# Must be identical to APP_API_TOKEN in the root .env / server/.env.
APP_API_TOKEN=devtoken123
# SQLite file, relative to this directory
DATABASE_PATH=eneros.db
# Open-Meteo weather: free for NON-commercial use only. For a commercial product, buy a key and set it here.
OPEN_METEO_API_KEY=
