# Web app (Vite). Copy to `.env`.
# The API server (see server/.env.example) must be running. During local
# development, Vite proxies /api requests to http://localhost:4000.
# Set VITE_API_URL only if the API is hosted on a separate origin.
# VITE_API_URL=https://api.example.com

# Clerk keys are read from the API's /api/config endpoint, so they only need to
# live in server/.env — you do NOT need to duplicate them here.
