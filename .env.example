# ─────────────────────────────────────────────────────────────────────────────
# EnerOS — local development environment (one file shared by all three services)
#
#   npm run setup      copies this file to `.env` and generates ENCRYPTION_KEY
#   npm run dev:all    starts web :3000, Node API :4000, Python connector :8000
#
# `.env` at the repo root is read by:
#   • the Next.js app        (Next.js loads the root `.env` itself)
#   • the Node API           (server/src/env.ts loads ../../.env)
#   • the Python connector   (scripts/dev-backend.mjs loads it before uvicorn,
#                             and backend/.env is still honoured as a fallback)
#
# Never commit `.env` — it is gitignored. Commit changes to this example instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
# Bearer token the Node API sends to the Python connector. BOTH sides read this
# same value, so they can never disagree. Change it for anything non-local.
APP_API_TOKEN=devtoken123

# Where the Node API finds the Python connector service (uvicorn, port 8000).
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Python connector — Fernet key used to encrypt provider API keys at rest.
# `npm run setup` fills this in automatically. Generate one by hand with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Python connector — SQLite file, relative to `backend/` (gitignored).
DATABASE_PATH=eneros.db

# ── Node API ──────────────────────────────────────────────────────────────────
# API port. Deliberately commented out: `next dev` also honours PORT, and the
# API already defaults to 4000. Uncomment only if 4000 is taken (then also set
# NEXT_PUBLIC_CONNECTOR_API_URL for the web app and the verify script).
# PORT=4000

# Browser origins allowed to call the API directly (same-origin /api calls via
# the Next.js dev proxy do not need CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:19006

# MongoDB is only needed for `npm run dev:api:mongo`; `npm run dev:all` runs the
# API with an in-memory MongoDB (server/src/local-memory.ts), so leave this unset.
# MONGODB_URI=mongodb://127.0.0.1:27017/eneros

# ── Optional integrations (the app degrades gracefully without them) ──────────
# Clerk auth — leave blank to use the built-in dev auth + demo login.
# CLERK_PUBLISHABLE_KEY=pk_test_xxx
# CLERK_SECRET_KEY=sk_test_xxx

# Cloudflare R2 uploads — blank disables uploads, the rest of the API works.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Gemini — powers bill extraction and grounded Copilot answers.
# GEMINI_API_KEY=

# Stripe subscription billing — blank runs checkout in labelled dev mode.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# APP_BASE_URL=http://localhost:3000

